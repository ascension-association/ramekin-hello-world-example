/build/
/.ramekin/
# Secret keys. Public keys (*.pub, recipients.txt) are safe to commit, and
# the CVE watch workflow needs ramekin-sign.pub to verify releases.
/keys/*.key
/keys/*.agekey
/keys/devices/
# The persistent overlay is large and binary; back it up rather than committing it.
/overlay.img
# The program, cross-compiled for the device and copied into the overlay.
/hello
